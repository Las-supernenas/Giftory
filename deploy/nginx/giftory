
server {
    listen 80;
    server_name giftory.duckdns.org;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name giftory.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/giftory.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/giftory.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
    }

    location / {
        proxy_pass http://127.0.0.1:5173;
    }
}
